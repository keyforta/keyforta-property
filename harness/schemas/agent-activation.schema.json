{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyforta.dev/schemas/agent-activation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "invocableLifecycles",
    "transitions",
    "activationRecords",
    "governanceChangeRecords",
    "externalEnforcement",
    "repositoryRecordPurpose"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "invocableLifecycles": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["core", "on-demand"] }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "requiredEvidence", "approvalGate"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "requiredEvidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "approvalGate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "activationRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "from", "to", "evidence"],
        "properties": {
          "agentId": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "reference": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "governanceChangeRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectType",
          "subjectId",
          "changedFields",
          "evidenceReferences"
        ],
        "properties": {
          "subjectType": {
            "enum": [
              "agent",
              "route",
              "activation-policy",
              "requirement-policy"
            ]
          },
          "subjectId": { "type": "string", "minLength": 1 },
          "changedFields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceReferences": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "externalEnforcement": { "type": "string", "minLength": 1 },
    "repositoryRecordPurpose": { "type": "string", "minLength": 1 }
  }
}
