{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyforta.dev/schemas/agent-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authority", "agents", "requiredCapabilities"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "authority": { "type": "string", "minLength": 1 },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "lifecycle",
          "capabilities",
          "prohibitions",
          "activationGate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 3 },
          "lifecycle": {
            "enum": ["core", "on-demand", "deferred", "experimental", "retired"]
          },
          "definitionPath": { "type": "string", "minLength": 1 },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "prohibitions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "activationGate": { "type": "string" }
        }
      }
    }
  }
}
