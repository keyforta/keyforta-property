{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyforta.dev/schemas/routing-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fallbackAgentId", "rules"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "fallbackAgentId": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "workArea",
          "leadAgentId",
          "reviewerAgentIds",
          "requiredCapabilities",
          "requiredReviewerCapabilities",
          "humanGate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^ROUTE-[0-9]{3}$" },
          "phase": { "type": "string", "minLength": 1 },
          "workArea": { "type": "string", "minLength": 1 },
          "leadAgentId": { "type": "string", "minLength": 1 },
          "reviewerAgentIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredCapabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredReviewerCapabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "humanGate": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
