{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyforta.dev/schemas/handoff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoffId",
    "taskId",
    "fromAgentId",
    "toAgentId",
    "status",
    "inputs",
    "expectedOutputs",
    "acceptanceCriteria",
    "evidence",
    "humanDecision",
    "history"
  ],
  "properties": {
    "handoffId": { "type": "string", "pattern": "^HANDOFF-[A-Z0-9-]+$" },
    "taskId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "fromAgentId": { "type": "string", "minLength": 1 },
    "toAgentId": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["proposed", "ready", "accepted", "rejected", "completed"]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "expectedOutputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outputId", "reference"],
        "properties": {
          "outputId": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "humanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "gate"],
      "properties": {
        "required": { "const": true },
        "gate": { "type": "string", "minLength": 1 }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "actor", "enteredAt", "evidenceReferences"],
        "properties": {
          "status": {
            "enum": ["proposed", "ready", "accepted", "rejected", "completed"]
          },
          "actor": { "type": "string", "minLength": 1 },
          "enteredAt": { "type": "string", "format": "date-time" },
          "evidenceReferences": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
