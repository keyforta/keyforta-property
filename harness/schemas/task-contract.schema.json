{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyforta.dev/schemas/task-contract.schema.json",
  "title": "KEYFORTA engineering task contract",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["contractVersion"],
        "properties": { "contractVersion": { "const": 2 } }
      },
      "then": {
        "required": ["phase", "workArea", "routingRuleId"]
      }
    }
  ],
  "required": [
    "taskId",
    "title",
    "businessObjectiveReference",
    "issueReference",
    "requirementReferences",
    "classification",
    "workflowState",
    "stateHistory",
    "assignedAgent",
    "supportingReviewers",
    "dependencies",
    "allowedPaths",
    "declaredProtectedPaths",
    "protectedPaths",
    "acceptanceCriteriaReferences",
    "acceptanceCriteria",
    "technicalDecisionReferences",
    "requiredScenarios",
    "requiredCommands",
    "requiredEvidence",
    "riskClassification",
    "securityImpact",
    "dataImpact",
    "observabilityImpact",
    "rollbackConsiderations",
    "humanApprovalRequirements",
    "repairCycle"
  ],
  "properties": {
    "contractVersion": { "type": "integer", "minimum": 1 },
    "taskId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "phase": { "type": "string", "minLength": 1 },
    "workArea": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 5 },
    "businessObjectiveReference": { "type": "string", "minLength": 1 },
    "issueReference": { "type": "string", "minLength": 1 },
    "requirementReferences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "classification": {
      "enum": [
        "feature",
        "bugfix",
        "refactor",
        "security",
        "infrastructure",
        "configuration",
        "documentation",
        "dependency",
        "operational",
        "emergency"
      ]
    },
    "workflowState": {
      "enum": [
        "proposed",
        "analyzed",
        "approved",
        "designed",
        "implementation-ready",
        "implemented",
        "verification-ready",
        "verified",
        "review-ready",
        "accepted",
        "released",
        "blocked",
        "changes-requested",
        "rejected",
        "superseded",
        "rolled-back"
      ]
    },
    "stateHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "actor", "enteredAt", "evidenceReferences"],
        "properties": {
          "state": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "enteredAt": { "type": "string", "format": "date-time" },
          "evidenceReferences": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approver",
              "role",
              "decision",
              "evidenceReference",
              "commitSha"
            ],
            "properties": {
              "approver": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "decision": { "const": "approved" },
              "evidenceReference": { "type": "string", "minLength": 1 },
              "commitSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "assignedAgent": { "type": "string", "minLength": 1 },
    "routingRuleId": { "type": "string", "pattern": "^ROUTE-[0-9]{3}$" },
    "supportingReviewers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "allowedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "declaredProtectedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "protectedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "acceptanceCriteriaReferences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirementReferences", "testReferences"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requirementReferences": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "testReferences": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "manualVerification": { "type": "string", "minLength": 1 }
        }
      },
      "minItems": 1
    },
    "technicalDecisionReferences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "requiredScenarios": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "requiredCommands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "requiredEvidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "riskClassification": { "enum": ["low", "medium", "high", "critical"] },
    "securityImpact": { "type": "string", "minLength": 1 },
    "dataImpact": { "type": "string", "minLength": 1 },
    "observabilityImpact": { "type": "string", "minLength": 1 },
    "rollbackConsiderations": { "type": "string", "minLength": 1 },
    "humanApprovalRequirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "repairCycle": { "type": "integer", "minimum": 0, "maximum": 3 }
  }
}
