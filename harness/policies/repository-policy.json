{
  "version": 1,
  "protectedPaths": [
    "AGENTS.md",
    ".github/copilot-instructions.md",
    ".github/instructions/",
    ".github/agents/",
    ".github/workflows/",
    "docs/product/",
    "docs/architecture/adr/",
    "harness/policies/",
    "harness/schemas/",
    "infra/postgres/migrations/"
  ],
  "approvalGates": [
    "functional-requirements",
    "mvp-scope",
    "microservices",
    "technology-stack",
    "paid-services",
    "authentication",
    "authorization",
    "data-retention",
    "destructive-migrations",
    "payment-boundaries",
    "security-controls",
    "quality-gates",
    "harness-policies",
    "deferred-agents",
    "production-infrastructure",
    "production-deployment"
  ],
  "forbiddenSecretPatterns": [
    "BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY",
    "ghp_[A-Za-z0-9]{20,}",
    "github_pat_[A-Za-z0-9_]{20,}",
    "(?:AZURE_CLIENT_SECRET|ENTRA_CLIENT_SECRET|DATABASE_PASSWORD|DB_PASSWORD|API_KEY|SAS_TOKEN|REFRESH_TOKEN|SIGNING_KEY)\\s*[:=]\\s*[\\\"']?(?!<|\\$\\{|process\\.env|example|synthetic)[^\\s\\\"']{8,}",
    "AccountKey=[A-Za-z0-9+/=]{16,}",
    "(?:^|[?&])sig=[A-Za-z0-9%+/=]{16,}"
  ],
  "generatedPaths": ["dist/", ".next/", "coverage/", "harness/reports/"]
}
