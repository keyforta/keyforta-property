{
  "name": "keyforta",
  "version": "0.1.0",
  "private": true,
  "description": "KEYFORTA property marketplace and management platform",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "pnpm --filter @keyforta/public-web dev",
    "dev:public": "pnpm --filter @keyforta/public-web dev",
    "dev:portal": "pnpm --filter @keyforta/portal-web dev",
    "dev:admin": "pnpm --filter @keyforta/admin-web dev",
    "dev:all": "pnpm --parallel --filter './apps/*-web' dev",
    "check:apps": "pnpm --recursive run check",
    "build:apps": "pnpm --recursive run build",
    "harness:self-test": "node harness/scripts/self-test.mjs",
    "test": "turbo run test",
    "turbo:build": "turbo run build",
    "turbo:check": "turbo run check",
    "turbo:test": "turbo run test",
    "verify": "pnpm check && pnpm build",
    "verify:agents": "node harness/scripts/verify-agents.mjs",
    "verify:all": "node harness/scripts/verify.mjs",
    "verify:classification": "node harness/scripts/verify-classification.mjs",
    "verify:evidence": "node harness/scripts/verify-evidence.mjs",
    "verify:skills": "node harness/scripts/verify-skills.mjs",
    "verify:task": "node harness/scripts/validate-contract.mjs",
    "verify:transition": "node harness/scripts/verify-transition.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "yaml": "^2.9.0"
  }
}
