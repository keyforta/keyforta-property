{
  "name": "@keyforta/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone synthetic MCP resource server",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@keyforta/contracts": "workspace:*",
    "@keyforta/types": "workspace:*",
    "@keyforta/system-health": "workspace:*",
    "fastify": "5.12.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
