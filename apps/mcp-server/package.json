{
  "name": "@keyforta/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-widget.mjs",
    "check": "pnpm test && pnpm typecheck && pnpm build && node --test test/build.test.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@keyforta/contracts": "workspace:*",
    "@keyforta/tool-system-health": "workspace:*",
    "@keyforta/types": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "5.12.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}