{
  "name": "@keyforta/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone authenticated read-only Model Context Protocol boundary for KEYFORTA",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@keyforta/contracts": "workspace:*",
    "@keyforta/types": "workspace:*",
    "fastify": "5.12.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
