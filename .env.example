NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_AUTH=password
DATABASE_URL=postgresql://keyforta_local@127.0.0.1:5432/keyforta
ENTRA_AUDIENCE=api://keyforta-api
ENTRA_ISSUER=https://example.ciamlogin.com/example-tenant-id/v2.0
ENTRA_JWKS_URI=https://example.ciamlogin.com/example-tenant-id/discovery/v2.0/keys
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=tenant-applications

# Web BFF runtime (server-only; do not prefix with NEXT_PUBLIC_)
API_INTERNAL_BASE_URL=http://127.0.0.1:4000
AUTH_PUBLIC_BASE_URL=http://localhost:3000
ENTRA_AUTHORIZATION_ENDPOINT=https://example.ciamlogin.com/example-tenant-id/oauth2/v2.0/authorize
ENTRA_TOKEN_ENDPOINT=https://example.ciamlogin.com/example-tenant-id/oauth2/v2.0/token
ENTRA_CLIENT_ID=replace-with-public-client-id
ENTRA_SCOPES=openid profile email api://keyforta-api/access
KEYFORTA_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
