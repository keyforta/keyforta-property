{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/test/**"],
      "outputs": ["dist/**", "!.vite/**"]
    },
    "@keyforta/public-web#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_PORTAL_WEB_URL"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/test/**"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "env": ["TEST_DATABASE_URL"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}